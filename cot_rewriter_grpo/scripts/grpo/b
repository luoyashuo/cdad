   593→            metrics["stats/length_ratio_below_low"] = below_low
   594→            metrics["stats/length_ratio_above_high"] = above_high
   595→            metrics["stats/length_ratio_in_range"] = len(ratios_array) - below_low - above_high
   596→
   597→    # FSF parse failure statistics (count of samples with parse failures)
