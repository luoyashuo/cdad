   565→            metrics["penalty/any/rate"] = penalized_count / total_count if total_count > 0 else 0.0
   566→            metrics["penalty/any/count"] = penalized_count
   567→
   568→    # Additional aggregate statistics for flags
   569→    if "format_valid" in reward_extra_infos_dict:
   570→        format_valid_list = reward_extra_infos_dict["format_valid"]
   571→        if format_valid_list:
   572→            valid_count = sum(1 for v in format_valid_list if v == 1)
   573→            metrics["stats/format_valid_rate"] = valid_count / len(format_valid_list)
   574→            metrics["stats/format_valid_count"] = valid_count
   575→
   576→    if "truncated" in reward_extra_infos_dict:
   577→        truncated_list = reward_extra_infos_dict["truncated"]
   578→        if truncated_list:
