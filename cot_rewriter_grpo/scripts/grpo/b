   555→        metrics[f"{metric_prefix}/rate"] = penalized_count / total_count if total_count > 0 else 0.0
   556→        metrics[f"{metric_prefix}/count"] = penalized_count
   557→
   558→    # Combined penalty rate: fraction of samples with ANY penalty triggered
   559→    if "penalized_flags" in reward_extra_infos_dict:
