-  push:
-    branches:
-      - main
-      - v0.*
-    paths:
-      - "verl/*.py"
-      # Other entrypoints
-      - "!examples/*trainer*"
-      - "!tests/**"
-      - "!verl/trainer/main_*.py"
-      - "!verl/trainer/fsdp_sft_trainer.py"
