+@ray.remote
+class VLLMWorkerActor:
+    """
+    Ray actor that runs vLLM on a specific GPU.
+    Each actor is a separate process with its own vLLM instance.
+    """
+
+    def __init__(
+        self,
+        model_path: str,
+        gpu_id: int,
+        gpu_memory_utilization: float = 0.4,
+        dtype: str = "float16",
+        max_model_len: int = 8192,
+    ):
+        import os
+        os.environ["CUDA_VISIBLE_DEVICES"] = str(gpu_id)
+
+        from vllm import LLM
+        from transformers import AutoTokenizer
+
+        print(f"[VLLMWorker-{gpu_id}] Initializing vLLM on GPU {gpu_id}...")
+
+        self.gpu_id = gpu_id
+        self.tokenizer = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)
+        self.llm = LLM(
+            model=model_path,
+            tensor_parallel_size=1,
+            gpu_memory_utilization=gpu_memory_utilization,
+            dtype=dtype,
+            max_model_len=max_model_len,
+            trust_remote_code=True,
+            enforce_eager=True,
+        )
+        print(f"[VLLMWorker-{gpu_id}] vLLM initialized successfully")
+
+    def compute_logprobs(
+        self,
+        prompts: List[str],
+        answer_starts: List[int],
+    ) -> List[Dict[str, Any]]:
+        """
+        Compute log probs for a batch of prompts.
+
+        Returns:
+            List of dicts, each containing:
+                - mean_log_prob: float
+                - min_log_prob: float
+                - token_log_probs: List[float] (optional, for debugging)
+        """
+        from vllm import SamplingParams
+        import time
+
+        sampling_params = SamplingParams(
+            max_tokens=1,
+            prompt_logprobs=1,
+            temperature=0,
+        )
+
+        print(f"[VLLMWorker-{self.gpu_id}] Processing {len(prompts)} prompts...")
+        start_time = time.time()
+
+        outputs = self.llm.generate(prompts, sampling_params)
+
+        elapsed = time.time() - start_time
+        speed = len(prompts) / elapsed if elapsed > 0 else 0
+        print(f"[VLLMWorker-{self.gpu_id}] Done: {len(prompts)} prompts in {elapsed:.2f}s ({speed:.1f} samples/s)")
+
+        # Extract log probs with mean and min
+        results = []
+        for output, ans_start in zip(outputs, answer_starts):
+            logprobs = self._extract_answer_logprobs(output.prompt_logprobs, ans_start)
+            if logprobs:
+                results.append({
+                    "mean_log_prob": sum(logprobs) / len(logprobs),
+                    "min_log_prob": min(logprobs),
+                    "token_log_probs": logprobs,
+                })
+            else:
+                results.append({
+                    "mean_log_prob": -100.0,
+                    "min_log_prob": -100.0,
+                    "token_log_probs": [],
+                })
+
+        return results
+
+    def _extract_answer_logprobs(self, prompt_logprobs, answer_start_idx: int) -> List[float]:
+        """Extract log probabilities for the answer portion."""
+        if not prompt_logprobs:
+            return []
+
+        answer_logprobs = []
+        for i in range(answer_start_idx, len(prompt_logprobs)):
+            if prompt_logprobs[i] is not None:
+                logprob_dict = prompt_logprobs[i]
+                if logprob_dict:
+                    for token_id, logprob_obj in logprob_dict.items():
+                        if hasattr(logprob_obj, 'logprob'):
+                            answer_logprobs.append(logprob_obj.logprob)
+                        else:
+                            answer_logprobs.append(float(logprob_obj))
+                        break
+        return answer_logprobs
+
+    def shutdown(self):
+        """Cleanup vLLM resources."""
+        import gc
+        import torch
+
+        print(f"[VLLMWorker-{self.gpu_id}] Shutting down...")
+        del self.llm
+        self.llm = None
+        gc.collect()
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+        print(f"[VLLMWorker-{self.gpu_id}] Shutdown complete")
+
