+"""
+Student Reward (Cognitive Reward) Module
+
+Computes R_cog = log P_student(Answer | Question, Rewrite_CoT)
+using a frozen Student Model with HuggingFace Transformers directly.
+
+The cognitive reward encourages the rewritten CoT to help the
+Student Model predict the correct answer with higher confidence.
+
+Supports multiple modes:
+1. Local persistent mode: Load model to GPU and keep it there
+2. Local offload mode: Load model to CPU, temporarily move to GPU for computation
+3. Remote mode: Call a separate GPU server via HTTP
+"""
+
+import gc
+import torch
+import requests
+from typing import Any, Dict, List, Optional, Union
+from transformers import AutoTokenizer, AutoModelForCausalLM
+from concurrent.futures import ThreadPoolExecutor, as_completed
+import threading
+
+from verl.experimental.reward.cot_rewriter.logging_config import logger
+
+
+def get_available_device(preferred_device: str = "cuda:3", allow_cpu: bool = True) -> torch.device:
+    """
+    Get available device for model loading.
+
+    Args:
+        preferred_device: Preferred CUDA device (e.g., "cuda:3", "cuda:0")
+        allow_cpu: If True, fallback to CPU when CUDA is not available.
+                  If False, raise RuntimeError when CUDA is not available.
+
+    Returns:
+        torch.device: Available device (CUDA or CPU)
+
+    Raises:
+        RuntimeError: If CUDA is not available and allow_cpu is False
+    """
+    if not torch.cuda.is_available():
+        if allow_cpu:
+            logger.info(f"[HFStudentRewardClient] CUDA is not available. Using CPU as fallback.")
+            return torch.device("cpu")
+        else:
+            raise RuntimeError(
+                "[HFStudentRewardClient] CUDA is not available. "
+                "Student Reward model requires GPU to run. "
+                "Please ensure CUDA_VISIBLE_DEVICES is set correctly in ray_kwargs.ray_init.runtime_env.env_vars "
+                "Or set reward_kwargs.allow_cpu=true to allow CPU fallback (slower)."
+            )
+
+    try:
+        device = torch.device(preferred_device)
+        # Test if device is accessible by creating a small tensor
+        _ = torch.tensor([1.0], device=device)
+        return device
+    except RuntimeError as e:
+        # Preferred device not available, try cuda:0
+        try:
+            device = torch.device("cuda:0")
+            _ = torch.tensor([1.0], device=device)
+            logger.info(f"[HFStudentRewardClient] Preferred device {preferred_device} not available, using cuda:0")
+            return device
+        except RuntimeError:
+            if allow_cpu:
+                logger.info(f"[HFStudentRewardClient] No CUDA device available, using CPU as fallback")
+                return torch.device("cpu")
+            raise RuntimeError(
+                f"[HFStudentRewardClient] No CUDA device available. "
+                f"Preferred device {preferred_device} failed with: {e}"
+            ) from e
+
+
+class HFStudentRewardClient:
+    """
+    HuggingFace Student Reward Client
+
+    Calculates cognitive reward using Student Model's log probability.
+    Uses HuggingFace Transformers directly (no vLLM dependency).
+
+    Supports two modes:
+    1. Persistent mode (enable_offload=False): Model stays on GPU
+    2. Offload mode (enable_offload=True): Model on CPU, loads to GPU on demand
+
+    When auto_offload=False (default), caller must manually call load_to_gpu() before
+    computing rewards and offload_to_cpu() after all batches are processed.
+    This avoids repeated load/offload overhead when processing multiple batches.
+    """
+
+    def __init__(
+        self,
+        model_path: str = "./models/Qwen3-1.7B",
+        device: str = "cuda:3",
+        dtype: torch.dtype = torch.bfloat16,
+        allow_cpu: bool = True,
+        enable_offload: bool = False,
+        offload_device: str = "cpu",
+        auto_offload: bool = False,
+    ):
+        """
+        Initialize HuggingFace Student Reward Client.
+
+        Args:
+            model_path: Path to Student Model
+            device: Preferred device to run model on (will fall back to CPU if not available)
+            dtype: Precision (bfloat16 recommended for GPU, float32 for CPU)
+            allow_cpu: If True, allow fallback to CPU when CUDA is not available
+            enable_offload: If True, enable load/offload mechanism for GPU memory saving
+            offload_device: Device to offload model when not in use (default: "cpu")
+            auto_offload: If True, automatically offload after each batch (slower but simpler).
+                         If False (default), caller must manually call load_to_gpu/offload_to_cpu.
+        """
+        self.model_path = model_path
+        self.enable_offload = enable_offload
+        self.offload_device = torch.device(offload_device)
+        self.auto_offload = auto_offload
+
+        # Determine compute device
+        if enable_offload:
+            try:
+                self.compute_device = torch.device(device)
+                _ = torch.tensor([1.0], device=self.compute_device)
+            except RuntimeError:
+                if allow_cpu:
+                    logger.info(f"[HFStudentRewardClient] Device {device} not available, using CPU")
+                    self.compute_device = torch.device("cpu")
+                    self.enable_offload = False
+                else:
+                    raise
+        else:
+            self.compute_device = get_available_device(device, allow_cpu=allow_cpu)
+
+        # Alias for compatibility
+        self.device = self.compute_device
+
+        # Use float32 for CPU (bfloat16 not well supported on CPU)
+        if self.compute_device.type == "cpu":
+            self.dtype = torch.float32
+            logger.info(f"[HFStudentRewardClient] Using float32 for CPU")
+        else:
+            self.dtype = dtype
+
+        logger.info(f"[HFStudentRewardClient] Initializing Student Reward Client")
+        logger.info(f"  Model Path: {model_path}")
+        logger.info(f"  Compute Device: {self.compute_device}")
+        logger.info(f"  Offload Enabled: {self.enable_offload}")
+        if self.enable_offload:
+            logger.info(f"  Offload Device: {self.offload_device}")
+
+        # Load tokenizer (always keep in memory)
+        logger.info(f"Loading tokenizer from {model_path}...")
+        self.tokenizer = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)
+
+        # Set pad_token if not set (important for batch processing)
+        if self.tokenizer.pad_token is None:
+            self.tokenizer.pad_token = self.tokenizer.eos_token
+
+        # Load model
+        self.model = None
+        if self.enable_offload:
+            # Load model to offload device (CPU) initially
+            logger.info(f"Loading model to {self.offload_device} (will load to GPU on demand)...")
+            self._load_model_to_device(self.offload_device)
+        else:
+            # Load model to compute device and keep it there
+            logger.info(f"Loading model to {self.compute_device} (persistent mode)...")
+            self._load_model_to_device(self.compute_device)
+
+    def _load_model_to_device(self, target_device: torch.device):
+        """Load model to specified device."""
+        if target_device.type == "cpu":
+            # For CPU, load with float32 and move to CPU
+            self.model = AutoModelForCausalLM.from_pretrained(
+                self.model_path,
+                trust_remote_code=True,
+                torch_dtype=torch.float32,
+            )
+            self.model = self.model.to(target_device)
+        else:
+            # For GPU, use device_map
+            self.model = AutoModelForCausalLM.from_pretrained(
+                self.model_path,
+                trust_remote_code=True,
+                torch_dtype=self.dtype,
+                device_map=target_device,
+            )
+        self.model.eval()
+
+    def load_to_gpu(self):
+        """Load model from CPU to GPU (only effective when enable_offload=True)."""
+        if not self.enable_offload:
+            return
+
+        if self.model is None:
+            raise RuntimeError("Model is None, cannot load to GPU")
+
+        logger.info(f"[HFStudentRewardClient] Loading model to {self.compute_device}...")
+
+        # Convert dtype if needed (CPU uses float32, GPU uses bfloat16)
+        if self.compute_device.type != "cpu" and self.model.dtype != self.dtype:
+            self.model = self.model.to(dtype=self.dtype)
+
+        # Move to GPU
+        self.model = self.model.to(self.compute_device)
+
+        # Clear CPU cache
+        gc.collect()
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+
+        logger.info(f"[HFStudentRewardClient] Model loaded to {self.compute_device}")
+
+    def offload_to_cpu(self):
+        """Offload model from GPU to CPU (only effective when enable_offload=True)."""
+        if not self.enable_offload:
+            return
+
+        if self.model is None:
+            raise RuntimeError("Model is None, cannot offload")
+
+        logger.info(f"[HFStudentRewardClient] Offloading model to {self.offload_device}...")
+
+        # Convert to float32 for CPU
+        if self.offload_device.type == "cpu":
+            self.model = self.model.to(dtype=torch.float32)
+
+        # Move to CPU
+        self.model = self.model.to(self.offload_device)
+
+        # Clear GPU cache
+        gc.collect()
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+
+        logger.info(f"[HFStudentRewardClient] Model offloaded to {self.offload_device}")
+
+    @torch.no_grad()
+    def _compute_single_log_prob(
+        self,
+        question: str,
+        cot: str,
+        answer: str,
+    ) -> Dict[str, Any]:
+        """
+        Compute log P(Answer | Question, CoT) for a single sample.
+
+        Uses Qwen3 chat template with reasoning_content field:
+        - User message: question
+        - Assistant message: answer with reasoning_content=cot
+
+        Format:
+            <|im_start|>user
+            {question}<|im_end|>
+            <|im_start|>assistant
+            <think>
+            {cot}
+            </think>
+
+            {answer}<|im_end|>
+
+        Args:
+            question: The input question
+            cot: The chain-of-thought reasoning (will be in <think> block)
+            answer: The ground truth answer
+
+        Returns:
+            dict with:
+                - mean_log_prob: float, answer 部分 token logprob 的平均值
+                - sum_log_prob: float, answer 部分 token logprob 的总和
+                - token_log_probs: List[float], 每个 answer token 的 logprob
+                - token_ids: List[int], answer 部分的 token IDs
+        """
+        # 使用 Qwen3 chat template 格式
+        messages = [
+            {'role': 'user', 'content': question},
+            {'role': 'assistant', 'content': answer, 'reasoning_content': cot}
+        ]
+
+        # 应用 chat template
+        full_text = self.tokenizer.apply_chat_template(
+            messages,
+            tokenize=False,
+            add_generation_prompt=False,
+        )
+
+        # 构建 prefix（不包含 answer）用于定位 answer 开始位置
+        prefix_messages = [
+            {'role': 'user', 'content': question},
+        ]
+        prefix_base = self.tokenizer.apply_chat_template(
+            prefix_messages,
+            tokenize=False,
+            add_generation_prompt=True,
+        )
+        prefix_with_think = prefix_base + f"<think>\n{cot}\n</think>\n\n"
+
+        # Tokenize 完整文本
+        inputs = self.tokenizer(
+            full_text,
+            return_tensors="pt",
+            truncation=True,
+            max_length=4096,
+        ).to(self.model.device)
+
+        # Forward pass to get logits
+        outputs = self.model(**inputs)
+        logits = outputs.logits[:, :-1, :]
+        all_token_ids = inputs["input_ids"][:, 1:]
+
+        # Calculate log probabilities
+        log_probs = torch.nn.functional.log_softmax(logits, dim=-1)
+        token_log_probs = log_probs.gather(2, all_token_ids.unsqueeze(2)).squeeze(2)
+
+        # 计算 prefix 的 token 长度
+        prefix_token_ids = self.tokenizer(
+            prefix_with_think,
+            return_tensors="pt",
+            truncation=True,
+            max_length=4096,
+        )["input_ids"][0]
+        prefix_len = len(prefix_token_ids) - 1
+
+        # Extract answer token logprobs and IDs
+        answer_log_probs = token_log_probs[0, prefix_len:].tolist()
+        answer_token_ids = all_token_ids[0, prefix_len:].tolist()
+
+        # 移除末尾的特殊 token
+        im_end_token_id = self.tokenizer.convert_tokens_to_ids("<|im_end|>")
+        eos_token_id = self.tokenizer.eos_token_id
+        special_ids = {im_end_token_id, eos_token_id}
+        if im_end_token_id is None:
+            special_ids = {eos_token_id}
+
+        while answer_token_ids and answer_token_ids[-1] in special_ids:
+            answer_token_ids.pop()
+            answer_log_probs.pop()
+
+        if answer_log_probs:
+            return {
+                "mean_log_prob": sum(answer_log_probs) / len(answer_log_probs),
+                "min_log_prob": min(answer_log_probs),
+                "sum_log_prob": sum(answer_log_probs),
+                "token_log_probs": answer_log_probs,
+                "token_ids": answer_token_ids,
+            }
+
+        return {
+            "mean_log_prob": -100.0,
+            "min_log_prob": -100.0,
+            "sum_log_prob": -100.0,
+            "token_log_probs": [],
+            "token_ids": [],
+        }
+
+    @torch.no_grad()
+    def compute_cognitive_reward_batch(
+        self,
+        questions: List[str],
+        rewrite_cots: List[str],
+        answers: List[str],
+        original_cots: Optional[List[str]] = None,
+        log_interval: int = 10,
+        micro_batch_size: Optional[int] = None,  # Ignored in single-GPU mode
+        gpu_batch_size: int = 8,  # Ignored in single-GPU mode
+    ) -> Dict[str, Any]:
+        """
+        Batch computation of cognitive rewards.
+
+        计算 rewrite_cot 和 original_cot 条件下 answer 的 mean log prob，
+        然后比较两者来决定 reward。
+
+        When enable_offload=True:
+        - Automatically loads model to GPU before computation
+        - Automatically offloads model to CPU after computation
+
+        Reward 逻辑:
+            reward = answer_log_prob(rewritten) - answer_log_prob(original)
+            where answer_log_prob = avg(token_log_probs) + 0.01 × min(token_log_probs)
+
+        Args:
+            questions: List of questions
+            rewrite_cots: List of rewritten CoTs (Actor 生成)
+            answers: List of ground truth answers
+            original_cots: List of original CoTs (用于比较，可选)
+            log_interval: Log progress every N samples (default: 10)
+            micro_batch_size: Ignored in single-GPU mode (for API consistency)
+            gpu_batch_size: Ignored in single-GPU mode (for API consistency)
+
+        Returns:
+            dict with:
+                - rewards: List[float], difference-based reward
+                - rewrite_mean_log_probs: List[float], rewrite_cot 条件下的 mean log prob
+                - original_mean_log_probs: List[float], original_cot 条件下的 mean log prob
+                - rewrite_token_log_probs: List[List[float]], rewrite 的 token-level logprob
+                - rewrite_token_ids: List[List[int]], rewrite 的 answer token IDs
+        """
+        # Auto load to GPU if offload enabled and auto_offload mode
+        if self.enable_offload and self.auto_offload:
+            self.load_to_gpu()
+
+        batch_size = len(questions)
+        logger.info(f"[StudentReward] Starting cognitive reward computation for {batch_size} samples...")
+
+        try:
+            rewards = []
+            rewrite_mean_log_probs = []
+            original_mean_log_probs = []
+            rewrite_token_log_probs = []
+            rewrite_token_ids = []
+
+            import time
+            start_time = time.time()
+
+            # alpha_cog for min_log_prob term
+            alpha_cog = 0.01
+
+            for i, (q, rewrite_cot, ans) in enumerate(zip(questions, rewrite_cots, answers)):
+                try:
+                    # 计算 rewrite_cot 条件下的 log prob
+                    rewrite_result = self._compute_single_log_prob(q, rewrite_cot, ans)
+                    rewrite_mean = rewrite_result["mean_log_prob"]
+                    rewrite_min = rewrite_result["min_log_prob"]
+                    rewrite_mean_log_probs.append(rewrite_mean)
+                    rewrite_token_log_probs.append(rewrite_result["token_log_probs"])
+                    rewrite_token_ids.append(rewrite_result["token_ids"])
+
+                    # 计算 rewrite 的 answer_log_prob
+                    # answer_log_prob = avg(token_log_probs) + alpha_cog × min(token_log_probs)
+                    rewrite_answer_log_prob = rewrite_mean + alpha_cog * rewrite_min
+
+                    # 如果提供了 original_cot，计算比较
+                    if original_cots and i < len(original_cots) and original_cots[i]:
+                        original_result = self._compute_single_log_prob(q, original_cots[i], ans)
+                        original_mean = original_result["mean_log_prob"]
+                        original_min = original_result["min_log_prob"]
+                        original_mean_log_probs.append(original_mean)
+
+                        # 计算 original 的 answer_log_prob
+                        original_answer_log_prob = original_mean + alpha_cog * original_min
+
+                        # 新 Reward: answer_log_prob(rewritten) - answer_log_prob(original)
+                        reward = rewrite_answer_log_prob - original_answer_log_prob
+                        rewards.append(reward)
+                    else:
+                        # No original_cot to compare with
+                        # Use rewrite_answer_log_prob directly as reward
+                        original_mean_log_probs.append(-100.0)
+                        rewards.append(rewrite_answer_log_prob)
+
+                    # Log progress every log_interval samples
+                    if (i + 1) % log_interval == 0 or (i + 1) == batch_size:
+                        elapsed = time.time() - start_time
+                        samples_per_sec = (i + 1) / elapsed if elapsed > 0 else 0
+                        eta = (batch_size - i - 1) / samples_per_sec if samples_per_sec > 0 else 0
+                        logger.info(
+                            f"[StudentReward] Progress: {i + 1}/{batch_size} samples "
+                            f"({100 * (i + 1) / batch_size:.1f}%) | "
+                            f"Speed: {samples_per_sec:.2f} samples/s | "
+                            f"ETA: {eta:.1f}s | "
+                            f"Last reward: {rewards[-1]:.4f}"
+                        )
+
+                except Exception as e:
+                    logger.error(f"[StudentReward] Error computing log_prob for sample {i}: {e}")
+                    rewards.append(0.0)
+                    rewrite_mean_log_probs.append(-100.0)
+                    original_mean_log_probs.append(-100.0)
+                    rewrite_token_log_probs.append([])
+                    rewrite_token_ids.append([])
+
+            total_time = time.time() - start_time
+            logger.info(
+                f"[StudentReward] Completed {batch_size} samples in {total_time:.2f}s "
+                f"(avg: {total_time / batch_size:.3f}s/sample)"
+            )
+
+            return {
+                "rewards": rewards,
+                "rewrite_mean_log_probs": rewrite_mean_log_probs,
+                "original_mean_log_probs": original_mean_log_probs,
+                "rewrite_token_log_probs": rewrite_token_log_probs,
+                "rewrite_token_ids": rewrite_token_ids,
+                # 向后兼容
+                "log_probs": rewrite_mean_log_probs,
+                "token_log_probs": rewrite_token_log_probs,
+                "token_ids": rewrite_token_ids,
+            }
+        finally:
+            # Auto offload to CPU after computation (only if auto_offload enabled)
+            if self.enable_offload and self.auto_offload:
+                self.offload_to_cpu()
+
+
+class RemoteStudentRewardClient:
+    """
+    Remote Student Reward Client
+
+    Calls a separate HTTP server running on GPU to compute log probabilities.
+    This allows reward computation to run on GPU even when the calling process
+    (RewardLoopWorker) doesn't have GPU access.
+
+    Usage:
+        1. Start the server: CUDA_VISIBLE_DEVICES=5 python -m verl.experimental.reward.cot_rewriter.student_reward_server --port 8765
+        2. Use this client in reward computation
+    """
+
+    def __init__(
+        self,
+        server_url: str = "http://localhost:8765",
+        timeout: float = 30.0,
+    ):
+        """
+        Initialize Remote Student Reward Client.
+
+        Args:
+            server_url: URL of the student reward server
+            timeout: Request timeout in seconds
+        """
+        self.server_url = server_url.rstrip("/")
+        self.timeout = timeout
+        self._check_server_health()
+
+    def _check_server_health(self):
+        """Check if the server is healthy."""
+        try:
+            response = requests.get(f"{self.server_url}/health", timeout=5)
+            response.raise_for_status()
+            health = response.json()
+            logger.info(f"[RemoteStudentRewardClient] Server healthy: {health}")
+        except Exception as e:
+            logger.warning(f"[RemoteStudentRewardClient] Warning: Server health check failed: {e}")
+            logger.warning(f"[RemoteStudentRewardClient] Make sure the server is running at {self.server_url}")
+
+    def compute_cognitive_reward_batch(
+        self,
+        questions: List[str],
+        rewrite_cots: List[str],
+        answers: List[str],
+        original_cots: Optional[List[str]] = None,
+    ) -> Dict[str, Any]:
+        """
+        Batch computation of cognitive rewards via HTTP.
+
+        如果提供了 original_cots，会比较 rewrite 和 original 的 mean log prob：
+        - 如果 rewrite_mean > original_mean → reward = 1
+        - 否则 → reward = 0
+
+        Args:
+            questions: List of questions
+            rewrite_cots: List of rewritten CoTs
+            answers: List of ground truth answers
+            original_cots: List of original CoTs (用于比较，可选)
+
+        Returns:
+            dict with:
+                - rewards: List[float], 0 或 1 的 reward
+                - rewrite_mean_log_probs: List[float], rewrite 的 mean log prob
+                - original_mean_log_probs: List[float], original 的 mean log prob
+                - rewrite_token_log_probs: List[List[float]], token-level logprob
+                - rewrite_token_ids: List[List[int]], token IDs
+        """
+        try:
+            request_data = {
+                "questions": questions,
+                "rewrite_cots": rewrite_cots,
+                "answers": answers,
+            }
+            if original_cots:
+                request_data["original_cots"] = original_cots
+
+            response = requests.post(
+                f"{self.server_url}/compute_log_probs",
+                json=request_data,
+                timeout=self.timeout,
+            )
+            response.raise_for_status()
+            result = response.json()
+            return {
+                "rewards": result["rewards"],
+                "rewrite_mean_log_probs": result["rewrite_mean_log_probs"],
+                "original_mean_log_probs": result["original_mean_log_probs"],
+                "rewrite_token_log_probs": result["rewrite_token_log_probs"],
+                "rewrite_token_ids": result["rewrite_token_ids"],
+                # 向后兼容
+                "log_probs": result["log_probs"],
+                "token_log_probs": result["token_log_probs"],
+                "token_ids": result["token_ids"],
+            }
+        except Exception as e:
+            logger.error(f"[RemoteStudentRewardClient] Error calling server: {e}")
+            batch_size = len(questions)
+            return {
+                "rewards": [0.0] * batch_size,
+                "rewrite_mean_log_probs": [-100.0] * batch_size,
+                "original_mean_log_probs": [-100.0] * batch_size,
+                "rewrite_token_log_probs": [[] for _ in range(batch_size)],
+                "rewrite_token_ids": [[] for _ in range(batch_size)],
+                "log_probs": [-100.0] * batch_size,
+                "token_log_probs": [[] for _ in range(batch_size)],
+                "token_ids": [[] for _ in range(batch_size)],
+            }
+
+
+class MultiGPUStudentRewardClient:
+    """
+    Multi-GPU Student Reward Client
+
+    Loads Student Model on multiple GPUs and processes batches in parallel.
+    This significantly speeds up reward computation for large batches.
+
+    Each GPU processes a portion of the batch concurrently using ThreadPoolExecutor.
+
+    Note: GPU indices are relative to CUDA_VISIBLE_DEVICES. If CUDA_VISIBLE_DEVICES=2,3,4,5,
+    then cuda:0 maps to physical GPU 2, cuda:1 maps to physical GPU 3, etc.
+    """
+
+    def __init__(
+        self,
+        model_path: str = "./models/Qwen3-1.7B",
+        devices: List[str] = None,
+        dtype: torch.dtype = torch.bfloat16,
+    ):
+        """
+        Initialize Multi-GPU Student Reward Client.
+
+        Args:
+            model_path: Path to Student Model
+            devices: List of CUDA devices (e.g., ["cuda:0", "cuda:1"])
+                    If None, will auto-detect all available GPUs (recommended)
+            dtype: Model precision
+        """
+        self.model_path = model_path
+        self.dtype = dtype
+
+        # Auto-detect devices if not provided (recommended)
+        # This respects CUDA_VISIBLE_DEVICES environment variable
+        if devices is None or len(devices) == 0:
+            num_gpus = torch.cuda.device_count()
+            if num_gpus == 0:
+                raise RuntimeError("[MultiGPUStudentReward] No CUDA devices available!")
+            devices = [f"cuda:{i}" for i in range(num_gpus)]
+            logger.info(f"[MultiGPUStudentReward] Auto-detected {num_gpus} GPUs")
+
+        self.devices = devices
+        self.num_gpus = len(devices)
+
+        logger.info(f"[MultiGPUStudentReward] Initializing with {self.num_gpus} GPUs: {devices}")
+
+        # Load tokenizer (shared)
+        logger.info(f"[MultiGPUStudentReward] Loading tokenizer from {model_path}...")
+        self.tokenizer = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)
+        if self.tokenizer.pad_token is None:
+            self.tokenizer.pad_token = self.tokenizer.eos_token
+
+        # Load model on each GPU
+        self.models = {}
+        self.locks = {}  # Thread locks for each GPU
+        for device in devices:
+            logger.info(f"[MultiGPUStudentReward] Loading model to {device}...")
+            # Check GPU memory before loading
+            if torch.cuda.is_available():
+                gpu_idx = int(device.split(":")[-1])
+                free_mem = torch.cuda.mem_get_info(gpu_idx)[0] / 1024**3
+                total_mem = torch.cuda.mem_get_info(gpu_idx)[1] / 1024**3
+                logger.info(f"[MultiGPUStudentReward] GPU {gpu_idx} memory: {free_mem:.1f}GB free / {total_mem:.1f}GB total")
+
+            model = AutoModelForCausalLM.from_pretrained(
+                model_path,
+                trust_remote_code=True,
+                torch_dtype=dtype,
+                device_map=device,
+            )
+            model.eval()
+
+            # Verify model is on correct device
+            actual_device = next(model.parameters()).device
+            logger.info(f"[MultiGPUStudentReward] Model loaded, actual device: {actual_device}")
+
+            # CRITICAL: Check if model is on GPU, not CPU
+            if actual_device.type == "cpu":
+                logger.error(f"[MultiGPUStudentReward] WARNING: Model is on CPU instead of {device}!")
+                logger.error(f"[MultiGPUStudentReward] This usually means GPU memory is full (vLLM not offloaded)")
+                logger.error(f"[MultiGPUStudentReward] Forcing model to {device}...")
+                # Force move to GPU
+                model = model.to(device)
+                actual_device = next(model.parameters()).device
+                logger.info(f"[MultiGPUStudentReward] After forcing: model on {actual_device}")
+
+            self.models[device] = model
+            self.locks[device] = threading.Lock()
+
+        logger.info(f"[MultiGPUStudentReward] All models loaded successfully")
+
+    def _prepare_input(self, question: str, cot: str, answer: str) -> Dict[str, Any]:
+        """Prepare tokenized input for a single sample (CPU operation)."""
+        # Build messages using Qwen3 chat template
+        messages = [
+            {'role': 'user', 'content': question},
+            {'role': 'assistant', 'content': answer, 'reasoning_content': cot}
+        ]
+
+        full_text = self.tokenizer.apply_chat_template(
+            messages, tokenize=False, add_generation_prompt=False
+        )
+
+        # Build prefix for locating answer start position
+        prefix_messages = [{'role': 'user', 'content': question}]
+        prefix_base = self.tokenizer.apply_chat_template(
+            prefix_messages, tokenize=False, add_generation_prompt=True
+        )
+        prefix_with_think = prefix_base + f"<think>\n{cot}\n</think>\n\n"
+
+        # Tokenize (CPU) - don't pad here, will pad in batch
+        inputs = self.tokenizer(
+            full_text, return_tensors="pt", truncation=True, max_length=4096
+        )
+        prefix_token_ids = self.tokenizer(
+            prefix_with_think, return_tensors="pt", truncation=True, max_length=4096
+        )["input_ids"][0]
+
+        return {
+            "input_ids": inputs["input_ids"].squeeze(0),  # Remove batch dim
+            "attention_mask": inputs["attention_mask"].squeeze(0),
+            "prefix_len": len(prefix_token_ids) - 1,
+        }
+
+    def _batch_forward_on_device(
+        self,
+        device: str,
+        prepared_inputs: List[Dict[str, Any]],
+        batch_size: int = 1,
+    ) -> List[Dict[str, Any]]:
+        """
+        Batch forward pass on a single GPU.
+        Pads inputs to same length and processes in fixed-size batches.
+        """
+        model = self.models[device]
+        actual_device = next(model.parameters()).device
+        all_results = []
+
+        pad_token_id = self.tokenizer.pad_token_id or self.tokenizer.eos_token_id
+        im_end_token_id = self.tokenizer.convert_tokens_to_ids("<|im_end|>")
+        eos_token_id = self.tokenizer.eos_token_id
+        special_ids = {im_end_token_id, eos_token_id} if im_end_token_id else {eos_token_id}
+
+        num_batches = (len(prepared_inputs) + batch_size - 1) // batch_size
+        log_interval = max(1, num_batches // 5)  # Log ~5 times during processing
+
+        for batch_idx in range(num_batches):
+            batch_start = batch_idx * batch_size
+            batch_end = min(batch_start + batch_size, len(prepared_inputs))
+            batch_items = prepared_inputs[batch_start:batch_end]
+
+            # Log progress
+            if batch_idx % log_interval == 0 or batch_idx == num_batches - 1:
+                progress = (batch_idx + 1) / num_batches * 100
+                logger.info(f"[{device}] Forward progress: {batch_idx+1}/{num_batches} batches ({progress:.0f}%)")
+
+            # Get max length in this batch
+            max_len = max(item["input_ids"].shape[0] for item in batch_items)
+
+            # Pad inputs
+            padded_input_ids = []
+            padded_attention_mask = []
+            prefix_lens = []
+
+            for item in batch_items:
+                input_ids = item["input_ids"]
+                attention_mask = item["attention_mask"]
+                seq_len = input_ids.shape[0]
+                pad_len = max_len - seq_len
+
+                if pad_len > 0:
+                    input_ids = torch.cat([
+                        torch.full((pad_len,), pad_token_id, dtype=input_ids.dtype),
+                        input_ids
+                    ])
+                    attention_mask = torch.cat([
+                        torch.zeros(pad_len, dtype=attention_mask.dtype),
+                        attention_mask
+                    ])
+
+                padded_input_ids.append(input_ids)
+                padded_attention_mask.append(attention_mask)
+                prefix_lens.append(item["prefix_len"] + pad_len)
+
+            # Stack and move to device
+            batch_input_ids = torch.stack(padded_input_ids).to(actual_device)
+            batch_attention_mask = torch.stack(padded_attention_mask).to(actual_device)
+
+            # Forward pass
+            try:
+                outputs = model(input_ids=batch_input_ids, attention_mask=batch_attention_mask)
+            except RuntimeError as e:
+                if "out of memory" in str(e).lower():
+                    logger.error(f"[{device}] OOM: batch_size={len(batch_items)}, max_len={max_len}")
+                    torch.cuda.empty_cache()
+                raise
+
+            # Extract log probs
+            logits = outputs.logits[:, :-1, :]
+            all_token_ids = batch_input_ids[:, 1:]
+            log_probs = torch.nn.functional.log_softmax(logits, dim=-1)
+            token_log_probs = log_probs.gather(2, all_token_ids.unsqueeze(2)).squeeze(2)
+
+            # Process each sample
+            for i, prefix_len in enumerate(prefix_lens):
+                answer_log_probs = token_log_probs[i, prefix_len:].tolist()
+                answer_token_ids = all_token_ids[i, prefix_len:].tolist()
+
+                while answer_token_ids and (answer_token_ids[-1] in special_ids or answer_token_ids[-1] == pad_token_id):
+                    answer_token_ids.pop()
+                    answer_log_probs.pop()
+
+                if answer_log_probs:
+                    all_results.append({
+                        "mean_log_prob": sum(answer_log_probs) / len(answer_log_probs),
+                        "min_log_prob": min(answer_log_probs),
+                        "token_log_probs": answer_log_probs,
+                        "token_ids": answer_token_ids,
+                    })
+                else:
+                    all_results.append({
+                        "mean_log_prob": -100.0,
+                        "min_log_prob": -100.0,
+                        "token_log_probs": [],
+                        "token_ids": [],
+                    })
+
+            # Clear intermediate tensors
+            del batch_input_ids, batch_attention_mask, outputs, logits, log_probs, token_log_probs
+
+        return all_results
+
+    def _compute_from_prepared(
+        self,
+        device: str,
+        prepared_input: Dict[str, Any],
+    ) -> Dict[str, Any]:
+        """Compute log prob from pre-tokenized input (single sample, for compatibility)."""
+        results = self._batch_forward_on_device(device, [prepared_input], batch_size=1)
+        return results[0]
+
+    def _compute_single_on_device(
+        self,
+        device: str,
+        question: str,
+        cot: str,
+        answer: str,
+    ) -> Dict[str, Any]:
+        """Compute log prob for a single sample on specified device (legacy, for compatibility)."""
+        prepared = self._prepare_input(question, cot, answer)
+        return self._compute_from_prepared(device, prepared)
+
+    def _process_sample(
+        self,
+        idx: int,
+        device: str,
+        question: str,
+        rewrite_cot: str,
+        answer: str,
+        original_cot: Optional[str],
+        alpha_cog: float = 0.01,
+    ) -> Dict[str, Any]:
+        """Process a single sample on specified device with thread lock.
+
+        New Reward formula:
+        - answer_log_prob(q, cot, a) = avg(token_log_probs) + alpha_cog × min(token_log_probs)
+        - reward = answer_log_prob(rewritten) - answer_log_prob(original)
+        """
+        with self.locks[device]:
+            try:
+                # Compute rewrite log prob
+                rewrite_result = self._compute_single_on_device(device, question, rewrite_cot, answer)
+                rewrite_mean = rewrite_result["mean_log_prob"]
+                rewrite_min = rewrite_result["min_log_prob"]
+
+                # answer_log_prob = avg + alpha_cog × min
+                rewrite_answer_log_prob = rewrite_mean + alpha_cog * rewrite_min
+
+                # Compute original log prob if available
+                if original_cot:
+                    original_result = self._compute_single_on_device(device, question, original_cot, answer)
+                    original_mean = original_result["mean_log_prob"]
+                    original_min = original_result["min_log_prob"]
+                    original_answer_log_prob = original_mean + alpha_cog * original_min
+
+                    # New Reward: difference between rewritten and original
+                    reward = rewrite_answer_log_prob - original_answer_log_prob
+                else:
+                    original_mean = -100.0
+                    reward = rewrite_answer_log_prob
+
+                return {
+                    "idx": idx,
+                    "reward": reward,
+                    "rewrite_mean": rewrite_mean,
+                    "original_mean": original_mean,
+                    "token_log_probs": rewrite_result["token_log_probs"],
+                    "token_ids": rewrite_result["token_ids"],
+                }
+            except Exception as e:
+                logger.error(f"[MultiGPUStudentReward] Error on sample {idx}: {e}")
+                return {
+                    "idx": idx,
+                    "reward": 0.0,
+                    "rewrite_mean": -100.0,
+                    "original_mean": -100.0,
+                    "token_log_probs": [],
+                    "token_ids": [],
+                }
+
+    def _compute_with_micro_batching(
+        self,
+        questions: List[str],
+        rewrite_cots: List[str],
+        answers: List[str],
+        original_cots: Optional[List[str]],
+        micro_batch_size: int,
+        log_interval: int,
+        gpu_batch_size: int = 8,
+    ) -> Dict[str, Any]:
+        """Process samples in micro-batches to avoid OOM."""
+        import time
+
+        batch_size = len(questions)
+        num_micro_batches = (batch_size + micro_batch_size - 1) // micro_batch_size
+
+        logger.info(f"[MultiGPUStudentReward] Processing {batch_size} samples in {num_micro_batches} micro-batches")
+        logger.info(f"[MultiGPUStudentReward] GPU batch size per forward: {gpu_batch_size}")
+
+        all_rewards = []
+        all_rewrite_means = []
+        all_original_means = []
+        all_token_log_probs = []
+        all_token_ids = []
+
+        start_time = time.time()
+
+        for mb_idx in range(num_micro_batches):
+            mb_start = mb_idx * micro_batch_size
+            mb_end = min(mb_start + micro_batch_size, batch_size)
+
+            mb_questions = questions[mb_start:mb_end]
+            mb_rewrite_cots = rewrite_cots[mb_start:mb_end]
+            mb_answers = answers[mb_start:mb_end]
+            mb_original_cots = original_cots[mb_start:mb_end] if original_cots else None
+
+            logger.info(f"[MultiGPUStudentReward] Micro-batch {mb_idx + 1}/{num_micro_batches}: samples {mb_start}-{mb_end - 1}")
+
+            # Process this micro-batch
+            mb_result = self._compute_full_batch(
+                mb_questions, mb_rewrite_cots, mb_answers, mb_original_cots, log_interval, gpu_batch_size
+            )
+
+            all_rewards.extend(mb_result["rewards"])
+            all_rewrite_means.extend(mb_result["rewrite_mean_log_probs"])
+            all_original_means.extend(mb_result["original_mean_log_probs"])
+            all_token_log_probs.extend(mb_result["rewrite_token_log_probs"])
+            all_token_ids.extend(mb_result["rewrite_token_ids"])
+
+            # Clear GPU cache between micro-batches (avoid gc.collect to prevent fragmentation)
+            torch.cuda.empty_cache()
+
+            elapsed = time.time() - start_time
+            speed = mb_end / elapsed if elapsed > 0 else 0
+            logger.info(f"[MultiGPUStudentReward] Progress: {mb_end}/{batch_size} ({100*mb_end/batch_size:.1f}%) | Speed: {speed:.2f} samples/s")
+
+        total_time = time.time() - start_time
+        logger.info(f"[MultiGPUStudentReward] All micro-batches done in {total_time:.2f}s")
+
+        return {
+            "rewards": all_rewards,
+            "rewrite_mean_log_probs": all_rewrite_means,
+            "original_mean_log_probs": all_original_means,
+            "rewrite_token_log_probs": all_token_log_probs,
+            "rewrite_token_ids": all_token_ids,
+            "log_probs": all_rewrite_means,
+            "token_log_probs": all_token_log_probs,
+            "token_ids": all_token_ids,
+        }
+
+    def _compute_full_batch(
+        self,
+        questions: List[str],
+        rewrite_cots: List[str],
+        answers: List[str],
+        original_cots: Optional[List[str]],
+        log_interval: int,
+        gpu_batch_size: int = 8,
+    ) -> Dict[str, Any]:
+        """Internal method to process a full batch without micro-batching."""
+        import time
+
+        batch_size = len(questions)
+        samples_per_gpu = batch_size // self.num_gpus if self.num_gpus > 0 else batch_size
+
+        start_time = time.time()
+        alpha_cog = 0.01
+        logger.info(f"[MultiGPUStudentReward] GPU batch size: {gpu_batch_size}")
+
+        # Phase 1: Pre-tokenize
+        all_prepared = []
+        for i in range(batch_size):
+            q, rewrite_cot, ans = questions[i], rewrite_cots[i], answers[i]
+            original_cot = original_cots[i] if original_cots and i < len(original_cots) else None
+
+            rewrite_prepared = self._prepare_input(q, rewrite_cot, ans)
+            original_prepared = self._prepare_input(q, original_cot, ans) if original_cot else None
+
+            all_prepared.append({
+                "global_idx": i,
+                "rewrite_prepared": rewrite_prepared,
+                "original_prepared": original_prepared,
+            })
+
+        # Phase 2: GPU forward passes
+        remainder = batch_size % self.num_gpus if self.num_gpus > 0 else 0
+        gpu_chunks = []
+        current_idx = 0
+        for gpu_idx in range(self.num_gpus):
+            count = samples_per_gpu + (1 if gpu_idx < remainder else 0)
+            gpu_chunks.append(all_prepared[current_idx:current_idx + count])
+            current_idx += count
+
+        all_results = [None] * batch_size
+
+        with ThreadPoolExecutor(max_workers=self.num_gpus) as executor:
+            futures = []
+            for gpu_idx, chunk in enumerate(gpu_chunks):
+                future = executor.submit(
+                    self._process_prepared_chunk,
+                    gpu_idx,
+                    chunk,
+                    alpha_cog,
+                    gpu_batch_size,
+                )
+                futures.append(future)
+
+            for future in futures:
+                chunk_results = future.result()
+                for r in chunk_results:
+                    all_results[r["global_idx"]] = r
+
+        return {
+            "rewards": [r["reward"] for r in all_results],
+            "rewrite_mean_log_probs": [r["rewrite_mean"] for r in all_results],
+            "original_mean_log_probs": [r["original_mean"] for r in all_results],
+            "rewrite_token_log_probs": [r["token_log_probs"] for r in all_results],
+            "rewrite_token_ids": [r["token_ids"] for r in all_results],
+        }
+
+    def _process_prepared_chunk(
+        self,
+        gpu_idx: int,
+        prepared_data: List[Dict[str, Any]],
+        alpha_cog: float = 0.01,
+        gpu_batch_size: int = 8,
+    ) -> List[Dict[str, Any]]:
+        """
+        Process pre-tokenized chunk on a single GPU using BATCH forward.
+        This maximizes GPU utilization by processing multiple samples at once.
+        """
+        device = self.devices[gpu_idx]
+        logger.info(f"[GPU {gpu_idx}] Starting chunk processing: {len(prepared_data)} samples on {device}")
+
+        # Set CUDA device for this thread (important for multi-threaded CUDA operations)
+        if torch.cuda.is_available():
+            cuda_device_idx = int(device.split(":")[-1])
+            torch.cuda.set_device(cuda_device_idx)
+            logger.info(f"[GPU {gpu_idx}] Set CUDA device to {cuda_device_idx}")
+
+        # Separate rewrite and original inputs
+        rewrite_inputs = [item["rewrite_prepared"] for item in prepared_data]
+        original_inputs = [item.get("original_prepared") for item in prepared_data]
+        global_indices = [item["global_idx"] for item in prepared_data]
+
+        # Batch forward for rewrite inputs
+        logger.info(f"[GPU {gpu_idx}] === Rewrite Forward === Processing {len(rewrite_inputs)} samples with batch_size={gpu_batch_size}")
+        rewrite_results = self._batch_forward_on_device(device, rewrite_inputs, batch_size=gpu_batch_size)
+        logger.info(f"[GPU {gpu_idx}] === Rewrite Forward Done === got {len(rewrite_results)} results")
+
+        # Batch forward for original inputs (only non-None ones)
+        # First collect valid original inputs and their indices
+        valid_original_inputs = []
+        valid_original_indices = []
+        for i, orig_input in enumerate(original_inputs):
+            if orig_input:
+                valid_original_inputs.append(orig_input)
+                valid_original_indices.append(i)
+
+        # Batch process valid original inputs
+        if valid_original_inputs:
+            logger.info(f"[GPU {gpu_idx}] === Original Forward === Processing {len(valid_original_inputs)} samples with batch_size={gpu_batch_size}")
+            valid_original_results = self._batch_forward_on_device(
+                device, valid_original_inputs, batch_size=gpu_batch_size
+            )
+            logger.info(f"[GPU {gpu_idx}] === Original Forward Done === got {len(valid_original_results)} results")
+        else:
+            logger.info(f"[GPU {gpu_idx}] No valid original inputs to process")
+            valid_original_results = []
+
+        # Map results back to original order
+        original_results = [{"mean_log_prob": -100.0, "min_log_prob": -100.0}] * len(original_inputs)
+        for idx, res in zip(valid_original_indices, valid_original_results):
+            original_results[idx] = res
+
+        # Compute rewards
+        results = []
+        for i, (global_idx, rewrite_res, original_res) in enumerate(
+            zip(global_indices, rewrite_results, original_results)
+        ):
+            rewrite_mean = rewrite_res["mean_log_prob"]
+            rewrite_min = rewrite_res["min_log_prob"]
+            rewrite_answer_log_prob = rewrite_mean + alpha_cog * rewrite_min
+
+            original_mean = original_res["mean_log_prob"]
+            original_min = original_res["min_log_prob"]
+
+            if original_mean > -99.0:
+                original_answer_log_prob = original_mean + alpha_cog * original_min
+                reward = rewrite_answer_log_prob - original_answer_log_prob
+            else:
+                reward = rewrite_answer_log_prob
+
+            results.append({
+                "global_idx": global_idx,
+                "reward": reward,
+                "rewrite_mean": rewrite_mean,
+                "original_mean": original_mean,
+                "token_log_probs": rewrite_res.get("token_log_probs", []),
+                "token_ids": rewrite_res.get("token_ids", []),
+            })
+
+        return results
+
+    @torch.no_grad()
+    def compute_cognitive_reward_batch(
+        self,
+        questions: List[str],
+        rewrite_cots: List[str],
+        answers: List[str],
+        original_cots: Optional[List[str]] = None,
+        log_interval: int = 50,
+        micro_batch_size: Optional[int] = None,
+        gpu_batch_size: int = 8,
+    ) -> Dict[str, Any]:
+        """
+        Optimized batch computation:
+        1. Pre-tokenize ALL samples in main thread (no GIL contention)
+        2. Distribute to GPUs for parallel forward passes
+
+        Args:
+            micro_batch_size: If set, process samples in micro-batches to avoid OOM.
+                              e.g., micro_batch_size=64 will process 64 samples at a time.
+            gpu_batch_size: Batch size for GPU forward pass (default: 8).
+                           Higher values increase GPU utilization but use more memory.
+        """
+        import time
+
+        batch_size = len(questions)
+
+        # If micro_batch_size is set, process in chunks to avoid OOM
+        if micro_batch_size and micro_batch_size < batch_size:
+            logger.info(f"[MultiGPUStudentReward] Using micro-batching: {batch_size} samples in chunks of {micro_batch_size}")
+            return self._compute_with_micro_batching(
+                questions, rewrite_cots, answers, original_cots,
+                micro_batch_size, log_interval, gpu_batch_size
+            )
+
+        samples_per_gpu = batch_size // self.num_gpus
+        logger.info(f"[MultiGPUStudentReward] Processing {batch_size} samples on {self.num_gpus} GPUs")
+        logger.info(f"[MultiGPUStudentReward] ~{samples_per_gpu} samples per GPU, gpu_batch_size={gpu_batch_size}")
+
+        start_time = time.time()
+        alpha_cog = 0.01
+
+        # ============ Phase 1: Pre-tokenize all samples (main thread, CPU) ============
+        logger.info(f"[MultiGPUStudentReward] Phase 1: Pre-tokenizing {batch_size} samples...")
+        tokenize_start = time.time()
+
+        all_prepared = []
+        for i in range(batch_size):
+            q, rewrite_cot, ans = questions[i], rewrite_cots[i], answers[i]
+            original_cot = original_cots[i] if original_cots and i < len(original_cots) else None
+
+            rewrite_prepared = self._prepare_input(q, rewrite_cot, ans)
+            original_prepared = self._prepare_input(q, original_cot, ans) if original_cot else None
+
+            all_prepared.append({
+                "global_idx": i,
+                "rewrite_prepared": rewrite_prepared,
+                "original_prepared": original_prepared,
+            })
+
+            if (i + 1) % 100 == 0:
+                logger.info(f"[MultiGPUStudentReward] Tokenized {i + 1}/{batch_size} samples")
+
+        tokenize_time = time.time() - tokenize_start
+        logger.info(f"[MultiGPUStudentReward] Phase 1 done: {tokenize_time:.2f}s ({batch_size / tokenize_time:.1f} samples/s)")
+
+        # ============ Phase 2: Split and process on GPUs in parallel ============
+        logger.info(f"[MultiGPUStudentReward] Phase 2: GPU forward passes...")
+        gpu_start = time.time()
+
+        # Split prepared data across GPUs
+        remainder = batch_size % self.num_gpus
+        gpu_chunks = []
+        current_idx = 0
+        for gpu_idx in range(self.num_gpus):
+            count = samples_per_gpu + (1 if gpu_idx < remainder else 0)
+            gpu_chunks.append(all_prepared[current_idx:current_idx + count])
+            current_idx += count
+
+        # Process all GPUs in parallel
+        all_results = [None] * batch_size
+
+        with ThreadPoolExecutor(max_workers=self.num_gpus) as executor:
+            futures = []
+            for gpu_idx, chunk in enumerate(gpu_chunks):
+                logger.info(f"[MultiGPUStudentReward] Submitting GPU {gpu_idx} task: {len(chunk)} samples")
+                future = executor.submit(
+                    self._process_prepared_chunk,
+                    gpu_idx,
+                    chunk,
+                    alpha_cog,
+                    gpu_batch_size,
+                )
+                futures.append((gpu_idx, future))
+            logger.info(f"[MultiGPUStudentReward] All {len(futures)} tasks submitted, waiting for results...")
+
+            # Collect results
+            for gpu_idx, future in futures:
+                chunk_results = future.result()
+                logger.info(f"[MultiGPUStudentReward] GPU {gpu_idx} completed {len(chunk_results)} samples")
+                for r in chunk_results:
+                    all_results[r["global_idx"]] = r
+
+        gpu_time = time.time() - gpu_start
+        total_time = time.time() - start_time
+        speed = batch_size / total_time if total_time > 0 else 0
+
+        logger.info(f"[MultiGPUStudentReward] Phase 2 done: {gpu_time:.2f}s")
+        logger.info(
+            f"[MultiGPUStudentReward] Total: {total_time:.2f}s "
+            f"(tokenize: {tokenize_time:.1f}s, GPU: {gpu_time:.1f}s, "
+            f"speed: {speed:.2f} samples/s)"
+        )
+
+        # Unpack results
+        rewards = [r["reward"] for r in all_results]
+        rewrite_mean_log_probs = [r["rewrite_mean"] for r in all_results]
+        original_mean_log_probs = [r["original_mean"] for r in all_results]
+        rewrite_token_log_probs = [r["token_log_probs"] for r in all_results]
+        rewrite_token_ids = [r["token_ids"] for r in all_results]
+
+        return {
+            "rewards": rewards,
+            "rewrite_mean_log_probs": rewrite_mean_log_probs,
+            "original_mean_log_probs": original_mean_log_probs,
+            "rewrite_token_log_probs": rewrite_token_log_probs,
+            "rewrite_token_ids": rewrite_token_ids,
+            "log_probs": rewrite_mean_log_probs,
+            "token_log_probs": rewrite_token_log_probs,
+            "token_ids": rewrite_token_ids,
+        }
+
+    def load_to_gpu(self):
+        """Ensure all models are on their designated GPUs with correct dtype."""
+        logger.info(f"[MultiGPUStudentReward] Checking/loading models to GPUs...")
+        logger.info(f"[MultiGPUStudentReward] Devices: {list(self.models.keys())}")
+
+        # First pass: check ALL GPUs have enough memory
+        for device in self.models.keys():
+            gpu_idx = int(device.split(":")[-1])
+            if torch.cuda.is_available():
+                free_mem = torch.cuda.mem_get_info(gpu_idx)[0] / 1024**3
+                logger.info(f"[MultiGPUStudentReward] GPU {gpu_idx} free memory: {free_mem:.1f}GB")
+                if free_mem < 4.0:
+                    logger.error(f"[MultiGPUStudentReward] GPU {gpu_idx} has only {free_mem:.1f}GB free, need ~4GB!")
+                    logger.error(f"[MultiGPUStudentReward] vLLM likely not offloaded. Check offload_rollout_for_reward config.")
+                    raise RuntimeError(f"Not enough GPU memory on {device}: {free_mem:.1f}GB free, need ~4GB")
+
+        # Second pass: move models to GPUs
+        for device, model in self.models.items():
+            actual_device = next(model.parameters()).device
+            if actual_device.type == "cpu":
+                logger.info(f"[MultiGPUStudentReward] Moving model from CPU to {device}...")
+                model.to(device=device, dtype=self.dtype)
+                actual_device = next(model.parameters()).device
+                logger.info(f"[MultiGPUStudentReward] Model now on {actual_device}")
+            else:
+                logger.info(f"[MultiGPUStudentReward] Model already on {actual_device}")
+
+    def offload_to_cpu(self):
+        """Offload all models to CPU."""
+        logger.info(f"[MultiGPUStudentReward] Offloading all models to CPU...")
+        for model in self.models.values():
+            model.to("cpu")
+        gc.collect()
+        torch.cuda.empty_cache()
+
