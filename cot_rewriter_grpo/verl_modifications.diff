-      - "recipe/dapo/**"
-  pull_request:
-    branches:
-      - main
-      - v0.*
-    paths:
-      - "**/*.py"
-      # Other entrypoints
-      - "!examples/**"
-      - "!tests/**"
-      - "!verl/trainer/main_*.py"
-      - "!verl/trainer/fsdp_sft_trainer.py"
-      # Other recipes
-      - "!recipe/**"
-      # Megatron
-      - "!verl/workers/**/megatron_*.py"
-      # Home
-      - "recipe/dapo/**"
-      # Entrypoints
-      - ".github/workflows/e2e_dapo.yml"
-      - "examples/data_preprocess/gsm8k.py"
-      - "tests/special_e2e/run_dapo.sh"
