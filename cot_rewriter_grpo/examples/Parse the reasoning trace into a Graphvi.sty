    def _parse_fsf_from_dot(self, dot_output: str) -> Optional[float] | Tuple[Optional[float], int]:
        """
        Parse FSF value from DOT graph format output.
        
        FSF = failed_nodes / total_nodes
        Failed nodes have fillcolor=lightpink
        Reflection/Critique nodes have fillcolor=lightyellow
        
        Args:
            dot_output: Raw model output text (DOT format)
            
        Returns:
            - If return_ref_count=False (default): FSF value between 0.0 and 1.0, or None if parsing fails
            - If return_ref_count=True: Tuple of (FSF value, reflection/critique node count)
        """
        try:
            import pydot

            # Strip leading newlines and markdown code blocks
            # Like analyze_rg_fsf.py, directly parse DOT without regex
            cleaned_output = dot_output.strip().lstrip('```dot').rstrip('```').strip('```').strip()

            # Directly parse with pydot (no regex matching needed)
            graphs = pydot.graph_from_dot_data(cleaned_output)

            if not graphs or len(graphs) == 0:
                logger.warning(f"[SGLangFSFActor-{self.gpu_ids}] Failed to parse DOT graph")
                return None

            graph = graphs[0]
            nodes = graph.get_nodes() or []
            
            node_count = len(nodes)
            if node_count == 0:
                return 0.0

            # Count failed nodes (fillcolor=lightpink) and reflection nodes (fillcolor=lightyellow)
            failed_nodes = 0
            reflection_nodes = 0
            for node in nodes:
                if node is None:
                    continue
                try:
                    fillcolor = node.get('fillcolor')
                    if fillcolor is not None:
                        fillcolor_str = str(fillcolor).strip('"').lower()
                        if fillcolor_str == 'lightpink':
                            failed_nodes += 1
                        elif fillcolor_str == 'lightyellow':
                            reflection_nodes += 1
                except:
                    continue

            fsf = failed_nodes / node_count
            # Log FSF parsing details at INFO level for visibility
            logger.info(f"[SGLangFSFActor-{self.gpu_ids}] FSF={fsf:.4f} ({failed_nodes}/{node_count} nodes, {node_count-failed_nodes} successful, {reflection_nodes} reflection)")
            return fsf, reflection_nodes

        except ImportError:
            logger.warning(f"[SGLangFSFActor-{self.gpu_ids}] pydot not installed")
            return None
        except Exception as e:
            logger.warning(f"[SGLangFSFActor-{self.gpu_ids}] DOT parsing error: {e}")
            return None
